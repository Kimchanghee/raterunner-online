{
  "name": "raterunner",
  "version": "0.1.0",
  "private": true,
  "description": "Currency exchange & remittance comparison (KR/EN)",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "fetch-rates": "tsx scripts/fetch-rates.ts",
    "deploy": "npm run fetch-rates && npm run build && cdk deploy --require-approval never"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-intl": "^3.20.0",
    "tailwindcss": "^3.4.13",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "aws-cdk-lib": "^2.160.0",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20"
  }
}
