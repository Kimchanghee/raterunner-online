---
// Build-time inline SVG: horizontal bars of true cost % per provider. No JS, no chart library.
import { buildLines, type Quote } from '../lib/cost.ts';
import { pct } from '../lib/format.ts';
interface Props { send: number; from: string; to: string; quotes: Quote[]; title: string }
const { send, from, quotes, title } = Astro.props;
const lines = buildLines(send, quotes).sort((a, b) => a.totalPct - b.totalPct);
const rowH = 30, labelW = 190, valueW = 70, chartW = 640;
const barW = chartW - labelW - valueW;
const maxPct = Math.max(0.5, ...lines.map((l) => l.totalPct));
const minPct = Math.min(0, ...lines.map((l) => l.totalPct));
const span = maxPct - minPct;
const x0 = labelW + ((0 - minPct) / span) * barW;
const h = lines.length * rowH + 30;
const id = `chart-${from}-${Astro.props.to}-${send}`;
---
<figure class="chart">
  <svg viewBox={`0 0 ${chartW} ${h}`} width={chartW} height={h} role="img" aria-labelledby={id}>
    <title id={id}>{title}</title>
    <line x1={x0} x2={x0} y1="0" y2={h - 24} stroke="#1a1915" stroke-width="1" />
    {lines.map((l, i) => {
      const y = i * rowH + 4;
      const w = (Math.abs(l.totalPct) / span) * barW;
      const x = l.totalPct >= 0 ? x0 : x0 - w;
      const feeShare = l.totalCost > 0 ? Math.max(0, l.fee) / l.totalCost : 0;
      return (
        <g>
          <text x={labelW - 8} y={y + 17} text-anchor="end" font-family="IBM Plex Mono, monospace" font-size="13" fill="#1a1915">{l.quote.name.length > 22 ? l.quote.name.slice(0, 21) + '…' : l.quote.name}</text>
          <rect x={x} y={y + 4} width={Math.max(1, w)} height={rowH - 12} fill="#a3161b" />
          {l.totalPct > 0 && feeShare > 0 && <rect x={x} y={y + 4} width={Math.max(0, w * feeShare)} height={rowH - 12} fill="#514d43" />}
          <text x={labelW + barW + 8} y={y + 17} font-family="IBM Plex Mono, monospace" font-size="13" fill="#1a1915">{pct(l.totalPct)}</text>
        </g>
      );
    })}
    <text x={labelW} y={h - 6} font-family="IBM Plex Mono, monospace" font-size="11" fill="#514d43">grey = upfront fee · red = exchange-rate markup · share of {send.toLocaleString('en-US')} {from}</text>
  </svg>
  <figcaption>{title}</figcaption>
</figure>
<style>
  .chart { margin: var(--s-5) 0; background: var(--slip); border-top: 2px solid var(--ink); border-bottom: 1px solid var(--rule); padding: var(--s-3); overflow-x: auto; }
  .chart svg { display: block; width: 100%; height: auto; min-width: 520px; }
  .chart figcaption { font: var(--t-xs) var(--mono); color: var(--ink-3); margin-top: var(--s-2); }
</style>
