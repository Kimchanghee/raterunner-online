---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions people ask' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">{title}</h2>
    <dl>
      {items.map((f) => (<div class="faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
    </dl>
  </section>
)}
<style>
  .faq dl { margin: 0; border-top: 2px solid var(--ink); max-width: var(--measure); }
  .faq-item { border-bottom: 1px solid var(--rule); padding: var(--s-4) 0; }
  .faq dt { font-weight: 650; font-size: var(--t-lg); line-height: 1.3; margin-bottom: var(--s-2); }
  .faq dd { margin: 0; color: var(--ink-2); }
</style>
